# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.

# Your project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# The public "anon" key (also shown as the "publishable" key in newer dashboards).
# It is safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Do NOT add the service_role / secret key here. The app does not need it,
# and it bypasses Row Level Security.
